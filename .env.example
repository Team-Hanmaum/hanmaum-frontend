# Copy to .env.local. VITE_* values are public and must not contain secrets.
# Server origin only; API functions include the /api prefix.
VITE_API_BASE_URL=http://localhost:8080

# Keep the existing UI preview until real authentication is connected.
VITE_ENABLE_MOCK_PREVIEW=true

# Allow opt-in QA tools (?qa=1). Tools remain hidden until enabled in a tab.
VITE_ENABLE_QA_TOOLS=true
