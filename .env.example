# Local BE example: copy to .env.development.local (development only).
# For the deployed BE, use pnpm setup:local and docs/local-development.md.
# VITE_* values are public and must not contain secrets.
HANMAUM_LOCAL_HTTPS=false
# Server origin only; API functions include the /api prefix.
VITE_API_BASE_URL=http://localhost:8080

# Public Kakao JavaScript key for sharing (not REST API key or client secret).
# Register SDK and product-link domains in Kakao Developers; see docs/deployment.md.
VITE_KAKAO_JAVASCRIPT_KEY=

# Legacy compatibility only; Mock preview activation has been removed.
VITE_ENABLE_MOCK_PREVIEW=false

# Allow opt-in QA tools (?qa=1). Tools remain hidden until enabled in a tab.
VITE_ENABLE_QA_TOOLS=true
